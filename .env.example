# ============================================
# OpsPilot AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# ── App ──────────────────────────────────────
APP_NAME=OpsPilot AI
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot_secret@localhost:5432/opspilot_db
DATABASE_URL_SYNC=postgresql://opspilot:opspilot_secret@localhost:5432/opspilot_db
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot_secret
POSTGRES_DB=opspilot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ──────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Gemini AI ────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── AWS S3 ───────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=opspilot-uploads

# ── Email (SMTP) ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@opspilot.ai

# ── Celery ───────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Sentry ───────────────────────────────────
SENTRY_DSN=

# ── Super Admin ──────────────────────────────
SUPER_ADMIN_EMAIL=admin@opspilot.ai
SUPER_ADMIN_PASSWORD=SuperAdmin123!
